{
  "name": "rebel-racoon",
  "version": "1.0.0",
  "private": true,
  "description": "Archie — interactive prototype for Agorapulse's AI content assistant (sources -> ideas -> drafts -> schedule).",
  "keywords": [
    "archie",
    "agorapulse",
    "prototype",
    "design-system"
  ],
  "author": "Matt Bousendorfer",
  "license": "ISC",
  "scripts": {
    "start": "npx serve -p 8000",
    "sync-ds": "node scripts/sync-ds.mjs",
    "postinstall": "node scripts/sync-ds.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:templates": "python3 scripts/check-template-comments.py",
    "prepare": "husky",
    "bump": "node scripts/cache-version.mjs bump",
    "check:versions": "node scripts/cache-version.mjs check",
    "check:dead": "node scripts/find-dead-code.mjs"
  },
  "dependencies": {
    "@agorapulse/ui-symbol": "^20.2.3",
    "@agorapulse/ui-theme": "^20.3.5"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "*.{js,mjs,css,html,json,md}": "prettier --write"
  }
}
